# Copy to .env (gitignored) and fill in. Nothing here is read at import time —
# scripts load it via python-dotenv when they actually need to call something.

# Hosted models + every LLM judge (scoring, probe verification, deliverable classification).
OPENROUTER_API_KEY=

# Tinker: the trained model organisms.
TINKER_API_KEY=

# A second Tinker key, for an organism whose checkpoint lives in another org. Private
# checkpoints can't be shared or enumerated across orgs, so sampling covert-manipulator
# needs both this key and that org's project id — the two below travel together.
TINKER_API_KEY_TAN_ORG=

# That org's Tinker project id (`tml:organization:<uuid>:default`). It identifies someone
# else's organization rather than this project, so registry.py names the variable and never
# the value; registry.project_id_for() reads it when the caller is built. Ask the checkpoint's
# owner. Without it, covert-manipulator raises a clear error instead of hitting a wrong project.
DANIEL_TAN_PROJECT=

# A third Tinker key, for the organisms in Ionut's org (no project id needed).
TINKER_API_KEY_IONUT_ORG=

# The AuditBench secret-loyalty organism, served on Modal/vLLM by
# scripts/organisms/serve_secret_loyalty_modal.py. Its serving caps max_model_len=16384,
# so pass a --max-tokens below the 20000 default or requests 400.
SL_BASE_URL=
SL_API_KEY=
