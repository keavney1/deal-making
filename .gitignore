# macOS
.DS_Store

# Node
node_modules/

# Environment files. The example carries variable NAMES and no values — it is the
# only one that belongs in the repo, and README/CLAUDE.md tell you to copy it.
.env
.env.*
!.env.example

# Regenerable figure intermediates — rebuild with make_dashboard_exp2.py --figure <name>
results/exp2/figure_*.html

# HVTB upstream copy (harbor datasets download); rung copies are regenerated by hvtb_prepare.py
envs/hvtb-upstream/
envs/hvtb-*/
envs/_stage/
envs/hvtb-online-check/

# Raw Harbor job/trial directories (screen recordings, verifier logs, config copies). The committed
# record is <jobs_dir>/<job>.jsonl from scripts/rewardhack/harbor_to_rows.py; raw dirs stay on disk only.
results/exp3-rewardhack/hvtb-*/*/
results/exp3-rewardhack/hvtb-*.log

# nested clones kept out of the repo (2026-09-29); our ImpossibleBench changes are in scripts/rewardhack/impossiblebench-pivotal.patch
envs/terminal-wrench/
envs/impossiblebench/
envs/netcheck/
envs/algotune-*/

# Full reasoning transcripts dumped for reading (2026-10-06, Mark: keep on disk, do not track).
# Regenerate with scripts/rewardhack/dump_cot.py; the scores they belong to are committed.
results/exp3-rewardhack/cot/traces/
