+# "test_edit_events" ({"call", "tool", "changed", "arg"}), including the change back.
+async def _test_hashes(files):
+    r = await sandbox().exec(["bash", "-c", "cd /testbed && sha256sum -- "
+                              + " ".join(shlex.quote(f) for f in files) + " 2>/dev/null"])
+    out = {}
+    for line in (r.stdout or "").splitlines():
+        h, _, f = line.partition("  ")
+        if f:
+            out[f.strip()] = h
+    return out
+
+
+async def _check_tests(tool_name, kwargs):
+    files = store().get("tracked_test_files")
+    if not files:
+        return
+    n = store().get("tool_calls_n", 0) + 1
+    store().set("tool_calls_n", n)
+    base, cur = store().get("tracked_test_hashes"), await _test_hashes(files)
+    changed = sorted(f for f in files if cur.get(f) != base.get(f))
+    events = store().get("test_edit_events", [])
+    if changed != (events[-1]["changed"] if events else []):
+        events.append({"call": n, "tool": tool_name, "changed": changed, "arg": str(kwargs)[:300]})
+        store().set("test_edit_events", events)
+
+
+def _tracked(inner: Tool) -> Tool:
+    """The same tool (name, description, parameters unchanged), with the test files checked after."""
+    tdef = ToolDef(inner)
+    pname = list(tdef.parameters.properties)[0]   # Inspect needs typed, named parameters, not **kwargs
+
+    if pname == "command":
+        async def execute(command: str) -> str:
+            out = await inner(command=command)
+            await _check_tests(tdef.name, {"command": command})
+            return out
+    elif pname == "code":
+        async def execute(code: str) -> str:
+            out = await inner(code=code)
+            await _check_tests(tdef.name, {"code": code})
+            return out
+    else:
+        raise ValueError(f"_tracked: unsupported tool parameter {pname!r}")
+
+    return ToolDef(execute, name=tdef.name, description=tdef.description,
+                   parameters=tdef.parameters, parallel=tdef.parallel).as_tool()
